{
  "name": "@panoma/core",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Panoma detection engine: discovers projects, identifies their stack, and scores their health.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "panoma-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./untrusted": {
      "panoma-src": "./src/untrusted.ts",
      "types": "./dist/untrusted.d.ts",
      "default": "./dist/untrusted.js"
    },
    "./fold": {
      "panoma-src": "./src/fold.ts",
      "types": "./dist/fold.d.ts",
      "default": "./dist/fold.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/untrusted.ts src/fold.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ignore": "^6.0.2",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1"
  }
}
